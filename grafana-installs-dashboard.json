    {
      "title": "Redirect Funnel",
      "description": "Page Load \u2192 Attempt \u2192 Success / Fallback",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 47
      },
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service_name=\"Lyrika Installs\", kind=\"event\"} |= `download_redirect` [$__range]))",
          "refId": "A",
          "instant": true
        },
        {
          "expr": "sum(count_over_time({service_name=\"Lyrika Installs\", kind=\"event\"} |= `redirect_button_shown` [$__range]))",
          "refId": "B",
          "instant": true
        },
        {
          "expr": "sum(count_over_time({service_name=\"Lyrika Installs\", kind=\"event\"} |= `redirect_manual_click` [$__range]))",
          "refId": "C",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "1. Redirect Fired"
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "2. Button Shown (redirect slow/failed)"
              },
              {
