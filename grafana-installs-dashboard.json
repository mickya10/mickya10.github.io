      "targets": [{"datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "expr": "sum by (event_data_source) (count_over_time({app_id=\"253\", kind=\"event\"} | logfmt | event_name=\"download_click\" [1h]))", "legendFormat": "{{event_data_source}}", "refId": "A"}],
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {}
    },
    {
      "id": 6,
      "title": "Clicks by Device",
      "type": "piechart",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 18},
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "targets": [{"datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "expr": "sum by (browser_mobile) (count_over_time({app_id=\"253\", kind=\"event\"} | logfmt | event_name=\"download_click\" [$__range]))", "legendFormat": "{{browser_mobile}}", "refId": "A"}],
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {}
    },
    {
      "id": 7,
      "title": "Clicks by Screen Size",
      "type": "piechart",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 18},
