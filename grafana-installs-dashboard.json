      "targets": [{"datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "expr": "sum by (event_data_screen) (count_over_time({app_id=\"253\", kind=\"event\"} | logfmt | event_name=\"download_click\" [$__range]))", "legendFormat": "{{event_data_screen}}", "refId": "A"}],
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {}
    },
    {
      "id": 8,
      "title": "Clicks by Language",
      "type": "piechart",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 18},
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "targets": [{"datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "expr": "sum by (event_data_language) (count_over_time({app_id=\"253\", kind=\"event\"} | logfmt | event_name=\"download_click\" [$__range]))", "legendFormat": "{{event_data_language}}", "refId": "A"}],
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {}
    },
    {
      "id": 9,
      "title": "Recent Clicks",
      "type": "logs",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 26},
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "targets": [{"datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "expr": "{app_id=\"253\", kind=\"event\"} | logfmt | event_name=\"download_click\"", "refId": "A"}],
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {}
    }
  ]
}
