{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"},
    {"type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0"}
  ],
  "id": null,
  "uid": null,
  "title": "Lyrika Installs - Download Clicks",
  "description": "Track download clicks from ad campaigns (Taboola, etc.)",
  "tags": ["lyrika", "installs", "campaigns"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 38,
  "version": 1,
  "refresh": "1m",
  "time": {"from": "now-7d", "to": "now"},
  "annotations": {"list": [{"builtIn": 1, "datasource": {"type": "grafana", "uid": "-- Grafana --"}, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard"}]},
  "templating": {"list": []},
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Total Download Clicks",
      "type": "stat",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "targets": [{"datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "expr": "sum(count_over_time({app_id=\"253\", kind=\"event\"} | logfmt | event_name=\"download_click\" [$__range]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}]}}, "overrides": []},
      "options": {}
    },
    {
      "id": 2,
      "title": "Clicks by Source",
      "type": "piechart",
      "gridPos": {"h": 8, "w": 9, "x": 6, "y": 0},
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "targets": [{"datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "expr": "sum by (event_data_source) (count_over_time({app_id=\"253\", kind=\"event\"} | logfmt | event_name=\"download_click\" [$__range]))", "legendFormat": "{{event_data_source}}", "refId": "A"}],
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {}
    },
    {
      "id": 3,
      "title": "Clicks by Campaign",
      "type": "piechart",
      "gridPos": {"h": 8, "w": 9, "x": 15, "y": 0},
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "targets": [{"datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "expr": "sum by (event_data_campaign) (count_over_time({app_id=\"253\", kind=\"event\"} | logfmt | event_name=\"download_click\" [$__range]))", "legendFormat": "{{event_data_campaign}}", "refId": "A"}],
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {}
    },
    {
      "id": 4,
      "title": "Clicks Today",
      "type": "stat",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 5},
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "targets": [{"datasource": {"type": "loki", "uid": "${DS_LOKI}"}, "expr": "sum(count_over_time({app_id=\"253\", kind=\"event\"} | logfmt | event_name=\"download_click\" [24h]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "blue"}]}}, "overrides": []},
      "options": {}
    },
    {
      "id": 5,
      "title": "Clicks Over Time",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 10},
